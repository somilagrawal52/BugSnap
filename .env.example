# Copy to apps/web/.env.local. Use your Supabase project's API settings.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUBMISSION_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM, with literal escaped newlines supported
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
CRON_SECRET=
# Optional Cloudflare Turnstile (enable both for public beta)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set only behind a reverse proxy that overwrites x-forwarded-for.
TRUST_PROXY=false
# Optional separate fictional demo project. Never use a customer project key here.
NEXT_PUBLIC_DEMO_PROJECT_KEY=
# Seed only; use a separate local/development Supabase project
SEED_EMAIL=demo@example.test
SEED_PASSWORD=
SEED_ALLOW_REMOTE=false

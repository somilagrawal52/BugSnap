{
  "name": "bugsnap",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @bugsnap/widget build && pnpm --filter @bugsnap/web build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.tools.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "check:env": "node scripts/check-env.mjs",
    "setup:local": "node scripts/local-setup.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@playwright/test": "1.65.1",
    "@supabase/supabase-js": "2.119.2",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@swc/core"
    ]
  },
  "type": "module"
}
